---
const phrases = [
  "Desarrollador Backend",
  "Estudiante de Ingeniería",
  "Fanático de PC Gaming", 
];
---

<section class="typewriter-container">
  <div class="content-wrapper">
    <h2 class="greeting">Hola, soy Camilo</h2>
    
    <div class="dynamic-text-wrapper">
      <span class="static-prefix">y soy </span>
      <span id="typewriter-text" class="typewriter"></span><span class="cursor">&nbsp;</span>
    </div>
  </div>
</section>

<script define:vars={{ phrases }}>
  // Variable para guardar el temporizador y poder limpiarlo si cambias de página rápido
  let typingTimer;

  function startTypewriter() {
    const textElement = document.getElementById('typewriter-text');
    const cursorElement = document.querySelector('.cursor');
    
    // Si no encuentra el elemento (ej. estamos en otra página), no hace nada
    if (!textElement) return;

    let currentPhraseIndex = 0;
    let currentCharIndex = 0;
    let isDeleting = false;
    let typeSpeed = 100;

    function type() {
      // Verificación de seguridad: si el elemento ya no existe (porque cambiaste de página), parar
      if (!document.getElementById('typewriter-text')) return;

      const currentPhrase = phrases[currentPhraseIndex];
      
      if (isDeleting) {
        textElement.textContent = currentPhrase.substring(0, currentCharIndex - 1);
        currentCharIndex--;
        typeSpeed = 50;
      } else {
        textElement.textContent = currentPhrase.substring(0, currentCharIndex + 1);
        currentCharIndex++;
        typeSpeed = 100;
      }

      if (!isDeleting && currentCharIndex === currentPhrase.length) {
        isDeleting = true;
        typeSpeed = 2000; 
      } else if (isDeleting && currentCharIndex === 0) {
        isDeleting = false;
        currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
        typeSpeed = 500;
      }

      typingTimer = setTimeout(type, typeSpeed);
    }

    // Iniciamos el bucle
    type();
  }

  // --- EL CAMBIO MÁGICO ---
  // En vez de 'DOMContentLoaded', usamos 'astro:page-load'
  // Esto asegura que corra CADA VEZ que navegas a la página
  document.addEventListener('astro:page-load', () => {
    // Limpiamos cualquier temporizador viejo por seguridad
    clearTimeout(typingTimer);
    startTypewriter();
  });
</script>

<style>
  /* Contenedor principal centrado */
  .typewriter-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 40vh; /* Altura suficiente pero no pantalla completa */
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .content-wrapper {
    text-align: center; /* O 'left' si prefieres alineado a la izquierda */
  }

  /* El saludo estático "Hola, soy..." */
  .greeting {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    color: #cbd5e1; /* Un gris azulado claro */
    margin: 0 0 0.5rem 0;
    font-weight: 400;
  }

  /* Contenedor de la línea animada */
  .dynamic-text-wrapper {
    font-size: clamp(2rem, 8vw, 4.5rem); /* Grande y responsivo */
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .static-prefix {
    color: #fff;
  }

  /* El texto que cambia */
  .typewriter {
    color: #6366f1; /* TU COLOR ÍNDIGO (Como pediste) */
    position: relative;
  }

  /* El cursor parpadeante */
  .cursor {
    display: inline-block;
    width: 3px;
    background-color: #6366f1; /* Cursor también índigo */
    margin-left: 5px;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Ajuste para móviles */
  @media (max-width: 768px) {
    .typewriter-container {
      min-height: 30vh;
    }
  }
</style>