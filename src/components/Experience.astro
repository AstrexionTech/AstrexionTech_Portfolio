---
import { Icon } from "astro-icon/components";

// DATOS: Aquí puedes editar fácilmente tu información
// 1. EXPERIENCIA LABORAL
const trabajos = [
  {
    fecha: "Enero 2025 - Marzo 2025", // Ajusta la fecha real de tu práctica
    titulo: "Práctica Laboral área Informática",
    empresa: "Comercializadora Ofertas Imperdibles SpA",
    desc: [
      "Apoyo en verificación y ajuste de SKU en Mercado Libre para optimizar la gestión de productos, asegurando coherencia y precisión en la información.",
      "Nivelación de productos 'Lady Genny' (2025) en Mercado Libre por el equipo de Cargas de Productos, revisando y ajustando imágenes, tallas, SKU y precios para garantizar la precisión de los productos en la plataforma.",
      "Optimización SEO de productos en las tiendas en línea 'Ofertas Imperdibles' y 'Abizi Comercializadora', mejora de descripciones y palabras clave SEO en la plataforma WordPress para aumentar la visibilidad y el posicionamiento en buscadores.",
    ],
    actual: false,
  },
];

// 2. EDUCACIÓN 
const estudios = [
  {
    fecha: "2023 - actualidad (En curso)",
    titulo: "Ingeniería en Informática",
    institucion: "Instituto Profesional Duoc UC",
    desc: ""
  }
];

// 3. HABILIDADES TÉCNICAS
const skills = {
  languages: ["C# .NET", "Node.js", "Java", "Python"],
  backend: ["ASP.NET Core Web API", "Express.js", "Spring Boot", "FastAPI"],
  databases: ["SQL Server", "Oracle", "MongoDB", "MySQL"],
  frontend: ["Angular", "Astro", "HTML/CSS"],
  tools: ["Docker", "Git/GitHub", "Postman", "Visual Studio Code"],
  cloud: ["Microsoft Azure", "Google Cloud Platform (GCP)"]
};

// 4. CERTIFICACIONES
const certs = [
  {
    nombre: "Microsoft Certified: Azure Data Fundamentals",
    empresa: "Microsoft",
    fecha: "Junio 2026",
    icon: "tabler:database",
    color: "#0078D4", // Azul Azure
    url: "https://www.credly.com/badges/a31edfcb-489a-4d18-aa93-81f461deb0d7/public_url",
  },
  {
    nombre: "Microsoft Certified: Azure Fundamentals",
    empresa: "Microsoft",
    fecha: "Enero 2026",
    icon: "tabler:cloud-computing",
    color: "#0078D4", // Azul Azure
    url: "https://www.credly.com/badges/879052ce-be48-4b38-878c-0546ebe0e411/public_url",
  },
  {
    nombre: "Scrum Fundamentals Certified",
    empresa: "SCRUMstudy",
    fecha: "Enero 2026",
    icon: "tabler:file-text",
    color: "#2FC700", // Verde 
    url: "https://www.scrumstudy.com/certification/verify?type=SFC&number=1142263",
  },
  {
    nombre: "Foundational C# with Microsoft",
    empresa: "freeCodeCamp",
    fecha: "Julio 2025",
    icon: "tabler:code",
    color: "#C400FF", // Rosado .NET
    url: "https://www.freecodecamp.org/certification/astrexiontech/foundational-c-sharp-with-microsoft",
  },
];
---

<section class="experience-section">
  
  <div class="column timeline-col">
    
    <div class="timeline-block">
      <h3 class="section-title"><Icon name="tabler:briefcase" /> Experiencia Laboral</h3>
      
      <div class="timeline">
        {trabajos.map((job) => (
          <div class="timeline-item">
            <div class="timeline-dot work-dot"></div>
            <div class="timeline-content">
              <span class="date">{job.fecha}</span>
              <h4>{job.titulo}</h4>
              <span class="company">{job.empresa}</span>
              <ul class="job-description">
                {job.desc.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="timeline-block">
      <h3 class="section-title"><Icon name="tabler:school" /> Educación</h3>
      
      <div class="timeline">
        {estudios.map((edu) => (
          <div class="timeline-item">
            <div class="timeline-dot edu-dot"><Icon name="tabler:book" /></div>
            
            <div class="timeline-content">
              <span class="date">{edu.fecha}</span>
              <h4>{edu.titulo}</h4>
              <span class="company">{edu.institucion}</span>
              <p class="edu-desc">{edu.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <div class="column details-col">
    
    <div class="details-block">
      <h3 class="section-title"><Icon name="tabler:certificate" /> Certificaciones</h3>
      <div class="certs-grid">
        {certs.map((cert) => (
          <div class="cert-card" style={`border-left: 4px solid ${cert.color}`}>
            <Icon name={cert.icon} class="cert-icon" style={`color: ${cert.color}`} />
            <div class="cert-content">
              <h4>{cert.nombre}</h4>
              <small>{cert.empresa} • {cert.fecha}</small>
              {cert.url && (
                <a href={cert.url} target="_blank" class="cert-link">
                  <Icon name="tabler:external-link" /> Ver Credencial
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="details-block">
      <h3 class="section-title"><Icon name="tabler:tools" /> Tech Stack</h3>
      <div class="skills-category">
        <span class="category-name">Lenguajes</span>
        <div class="tags">{skills.languages.map(s => <span class="tag languages">{s}</span>)}</div>
      </div>
      <div class="skills-category">
        <span class="category-name">Frontend</span>
        <div class="tags">{skills.frontend.map(s => <span class="tag frontend">{s}</span>)}</div>
      </div>
      <div class="skills-category">
        <span class="category-name">Backend</span>
        <div class="tags">{skills.backend.map(s => <span class="tag backend">{s}</span>)}</div>
      </div>
      <div class="skills-category">
        <span class="category-name">Bases de Datos</span>
        <div class="tags">{skills.databases.map(s => <span class="tag databases">{s}</span>)}</div>
      </div>
      <div class="skills-category">
        <span class="category-name">DevOps & Herramientas</span>
        <div class="tags">{skills.tools.map(s => <span class="tag tools">{s}</span>)}</div>
      </div>
      <div class="skills-category">
        <span class="category-name">Cloud Computing</span>
        <div class="tags">{skills.cloud.map(s => <span class="tag cloud">{s}</span>)}</div>
      </div>
    </div>

  </div>
</section>

<style>
  /* CONFIGURACIÓN GENERAL */
  .experience-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding: 1rem 0;
    max-width: 1000px;
    margin: 0 auto;
  }

  .timeline-block {
    margin-bottom: 4rem; /* Separación entre el bloque de Trabajo y Educación */
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 2rem;
    border-bottom: 2px solid rgba(99, 102, 241, 0.3);
    padding-bottom: 0.5rem;
  }

  /* --- TIMELINE --- */
  .timeline {
    position: relative;
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    margin-left: 1rem;
    padding-left: 2rem;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-dot {
    position: absolute;
    left: -2.6rem;
    top: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 3px solid #1a1a1a;
  }

  /* Punto de Trabajo: Color Índigo simple */
  .work-dot {
    background: #6366f1;
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
  }

  /* Punto de Educación: Color Esmeralda + Icono dentro */
  .edu-dot {
    background: #10b981;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
    width: 1.8rem; /* Un poco más grande para el icono */
    height: 1.8rem;
    left: -3rem; /* Ajuste de posición por el tamaño */
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 1rem;
  }

  /* Contenido */
  .timeline-content .date { font-size: 0.85rem; color: #6366f1; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
  .timeline-content h4 { margin: 0.5rem 0 0.2rem; font-size: 1.2rem; color: #fff; }
  .timeline-content .company { display: block; font-style: italic; color: #bbb; margin-bottom: 0.8rem; }
  
  /* Lista de Tareas (Trabajo) */
  .job-description { margin: 0.8rem 0 0 0; padding-left: 1.2rem; list-style-type: disc; text-align: justify; }
  .job-description li { color: white; font-size: 0.95rem; line-height: 1.6; margin-bottom: 0.4rem; }
  .job-description li::marker { color: #6366f1; }

  /* Descripción simple (Educación) */
  .edu-desc { color: white; font-size: 0.95rem; line-height: 1.5; margin: 0; text-align: justify;}

  /* --- CERTS & SKILLS (Estilos previos conservados) --- */
  .certs-grid { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 3rem; }
  .cert-card { display: flex; align-items: flex-start; gap: 1rem; background: rgba(255, 255, 255, 0.03); padding: 1.2rem; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.05); transition: transform 0.2s; }
  .cert-card:hover { transform: translateX(5px); background: rgba(255, 255, 255, 0.07); }
  .cert-icon { font-size: 2rem; flex-shrink: 0; margin-top: 5px; }
  .cert-content { display: flex; flex-direction: column; }
  .cert-card h4 { margin: 0 0 0.3rem 0; color: #fff; font-size: 1rem; line-height: 1.3; }
  .cert-card small { color: #888; display: block; margin-bottom: 0.8rem; }
  .cert-link { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #ccc; text-decoration: none; background: rgba(255, 255, 255, 0.1); padding: 0.3rem 0.6rem; border-radius: 4px; width: fit-content; transition: all 0.2s ease; }
  .cert-link:hover { background: rgba(255, 255, 255, 0.2); color: #fff; }

  /* --- ESTILOS DE CERTIFICACIONES (Modo Dark Solid) --- */
  
  .cert-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    
    /* CAMBIO PRINCIPAL: Fondo sólido muy oscuro */
    background-color: #0a0a0a; 
    
    /* Borde sutil alrededor (el borde izquierdo de color se mantiene por el HTML) */
    border: 1px solid rgba(255, 255, 255, 0.08);
    
    padding: 1.2rem;
    border-radius: 12px; /* Un poco más redondeado */
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    
    /* Sombra suave inicial */
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
  }
  
  .cert-card:hover {
    transform: translateX(5px);
    
    /* Al pasar el mouse, aclaramos apenas el borde y aumentamos la sombra */
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.7);
    
    /* Opcional: Un fondo apenas más claro para dar feedback */
    background-color: #121212; 
  }

  .skills-category { margin-bottom: 1.5rem; }
  .category-name { display: block; font-size: 0.9rem; color: #bbb; margin-bottom: 0.8rem; font-weight: 600; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tag { padding: 0.3rem 0.8rem; border-radius: 20px; font-size: 0.85rem; font-weight: 500; }
  .backend { background: rgb(0, 0, 0); color: #173bee; border: 1px solid rgba(99, 102, 241, 0.3); }
  .databases { background: rgb(0, 0, 0); color: #ff1ca8; border: 1px solid rgba(99, 102, 241, 0.3); }
  .languages { background: rgb(0, 0, 0); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3); }
  .frontend { background: rgb(0, 0, 0); color: #fbcfe8; border: 1px solid rgba(236, 72, 153, 0.3); }
  .tools { background: rgb(0, 0, 0); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.3); }
  .cloud { background: rgb(0, 0, 0); color: #e7b62e; border: 1px solid rgba(255, 115, 0, 0.3); }

  /* --- ESTILOS DE TAGS (TECH STACK) ACTUALIZADOS --- */
  
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem; /* Un poco más de espacio entre ellos */
  }

  .tag {
    padding: 0.4rem 1rem;
    border-radius: 30px; /* Bien redondos (Pills) */
    font-size: 0.85rem;
    font-weight: 600; /* Un poco más gordita la letra para que se lea bien */
    letter-spacing: 0.5px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    
    /* Aseguramos que el fondo tape lo que hay detrás */
    backdrop-filter: none; 
  }

  .tag:hover {
    transform: translateY(-2px);
  }

  /* LENGUAJES (Rojo) */
  .languages {
    background-color: #0f111a; /* Fondo MUY oscuro (casi negro) */
    color: #ccc;            /* Texto claro */
    border: 1px solid rgba(255, 43, 47, 1); /* Borde definido */
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.1); /* Sutil resplandor */
  }

  .languages:hover {
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    border-color: tomato;
  }

  /* BACKEND (Indigo) */
  .backend {
    background-color: #0f111a; /* Fondo MUY oscuro (casi negro) */
    color: #a5b4fc;            /* Texto claro */
    border: 1px solid rgba(99, 102, 241, 0.6); /* Borde definido */
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.1); /* Sutil resplandor */
  }
  
  .backend:hover {
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    border-color: #6366f1;
  }

  /* FRONTEND (Rosa) */
  .frontend {
    background-color: #1a0f14; /* Fondo oscuro con tinte rojizo */
    color: #fbcfe8;
    border: 1px solid rgba(236, 72, 153, 0.6);
    box-shadow: 0 4px 10px rgba(236, 72, 153, 0.1);
  }

  .frontend:hover {
    box-shadow: 0 4px 15px rgba(236, 72, 153, 0.3);
    border-color: #ec4899;
  }

  /* BASES DE DATOS */
  .databases {
    background-color: rgba(20, 59, 26, 1); /* Fondo oscuro con tinte rojizo */
    color: chartreuse;
    border: 1px solid rgba(0, 176, 29, 1);;
    box-shadow: 0 4px 10px rgba(236, 72, 153, 0.1);
  }

  /* TOOLS / DEVOPS (Verde Esmeralda) */
  .tools {
    background-color: #061812; /* Fondo oscuro con tinte verdoso */
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.6);
    box-shadow: 0 4px 10px rgba(16, 185, 129, 0.1);
  }

  .tools:hover {
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    border-color: #10b981;
  }

  /* CLOUD COMPUTING */
  .cloud {
    background-color: #1a0f14;
    color:#e7b62e;
    border: 1px solid rgba(250, 115, 5, 0.3);
  }

  .cloud:hover {
    box-shadow: 0 4px 15px rgba(185, 145, 16, 0.3);
    border-color: #b99a10;
  }

  @media (max-width: 768px) {
    .experience-section { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>