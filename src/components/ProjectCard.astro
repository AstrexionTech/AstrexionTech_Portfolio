---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  stack: string[];
  image?: string;
  repoFront?: string;
  repoBack?: string;
  demoUrl?: string;
  iconName?: string;
}

const { 
  title, 
  description, 
  stack, 
  image, 
  repoFront, 
  repoBack, 
  demoUrl, 
  iconName = "tabler:code" 
} = Astro.props;
---

<article class="card">
  
  {image && (
    <div class="card-image">
      <img src={image} alt={title} />
    </div>
  )}

  <div class="card-content">
    <div class="card-header">
      <Icon name={iconName} class="card-icon" />
      <h3>{title}</h3>
    </div>
    
    <p class="description">{description}</p>
    
    <div class="tags">
      {stack.map((tech) => <span class="tag">{tech}</span>)}
    </div>

    <div class="card-actions">
      
      <div class="repo-group">
        {repoFront && (
          <a href={repoFront} target="_blank" class="btn btn-github" title="Repositorio Frontend">
            <Icon name="tabler:brand-github" /> Front
          </a>
        )}

        {repoBack && (
          <a href={repoBack} target="_blank" class="btn btn-github" title="Repositorio Backend">
            <Icon name="tabler:server" /> Back
          </a>
        )}
      </div>

      {demoUrl && (
        <a href={demoUrl} target="_blank" class="btn btn-demo" title="Ver Proyecto en Vivo">
          <Icon name="tabler:external-link" /> Demo
        </a>
      )}

    </div>

  </div>
</article>

<style>
  /* --- ESTILOS GENERALES DE LA TARJETA (Mantenemos la base limpia) --- */
  .card {
    background: rgba(23, 23, 23, 0.7); /* Un poco más oscuro para contraste */
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px; /* Bordes más redondeados y modernos */
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%; /* Para que todas las cards tengan la misma altura si están en grid */
  }
  
  .card:hover {
    transform: translateY(-5px);
    border-color: rgba(99, 102, 241, 0.5);
  }

  .card-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .card:hover .card-image img { transform: scale(1.05); }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-header { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 0.8rem; }
  .card-icon { font-size: 1.5rem; color: #6366f1; }
  h3 { margin: 0; font-size: 1.3rem; color: #fff; font-weight: 600; }
  
  .description { color: #a3a3a3; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .tag { background: rgba(255,255,255,0.05); color: #ccc; font-size: 0.75rem; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); }

  /* --- AQUÍ ESTÁ LA MAGIA DE LOS BOTONES --- */
  
  .card-actions {
    display: flex;
    justify-content: space-between; /* Separa Repos a la izq y Demo a la derecha */
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: auto;
  }

  .repo-group {
    display: flex;
    gap: 0.5rem;
  }

  /* Estilo Base del Botón */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 8px; /* Bordes suaves */
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  /* Variante 1: GitHub (Secundario) */
  /* Fondo oscuro sutil, borde discreto */
  .btn-github {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e5e5e5;
  }

  .btn-github:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #fff;
    color: #fff;
    transform: translateY(-2px);
  }

  /* Variante 2: Demo (Primario) */
  /* Color sólido llamativo (Índigo) con brillo */
  .btn-demo {
    background-color: #4f46e5; /* Índigo vibrante */
    color: #ffffff;
    border: 1px solid #4f46e5;
    box-shadow: 0 4px 14px 0 rgba(79, 70, 229, 0.3); /* Resplandor */
  }

  .btn-demo:hover {
    background-color: #4338ca; /* Un poco más oscuro al hover */
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.5);
    transform: translateY(-2px);
  }

  /* Ajuste para iconos dentro de botones */
  .btn svg {
    font-size: 1.1rem;
  }
</style>