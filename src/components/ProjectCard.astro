---
// Importamos el componente de íconos
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  stack: string[];
  // Opcional: Permitir pasar un nombre de ícono diferente por proyecto
  iconName?: string; 
}

const { title, description, stack, iconName = "tabler:code" } = Astro.props;
---

<article class="card">
  <div class="card-header">
    <Icon name={iconName} class="card-icon" />
    
    <h3>{title}</h3>
  </div>
  
  <p>{description}</p>
  
  <div class="tags">
    {stack.map((tech) => <span class="tag">{tech}</span>)}
  </div>
</article>

<style>
  .card {
    background: rgba(255, 255, 255, 0.05); /* Fondo sutil */
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform 0.2s;
  }
  
  .card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* --- AQUÍ ESTÁ LA MAGIA DE LA ALINEACIÓN --- */
  .card-header {
    display: flex;         /* Activa el modo flexible */
    align-items: center;   /* Centra verticalmente el ícono con el texto */
    gap: 0.75rem;          /* Espacio entre el ícono y el título */
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2rem;       /* Tamaño del ícono */
    color: #6366f1;        /* Color del ícono (ej. Índigo) */
    flex-shrink: 0;        /* Evita que el ícono se aplaste si el título es largo */
  }

  h3 {
    margin: 0;             /* Quitamos margen por defecto para que alinee bien */
    font-size: 1.25rem;
    color: #fff;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    background: rgba(255, 255, 255, 0.1);
    color: #ccc;
    font-size: 0.85rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
</style>