---
import Layout from "../layouts/Layout.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { Icon } from 'astro-icon/components';

const proyectos = [
    {
        titulo: "GreenStyle Store E-commerce",
        descripcion: "Aplicación e-commerce para una tienda de artículos reciclables y sostenibles.",
        stack: ["C#", ".NET 8", "SQL Server", "Docker"],
        backend: "https://github.com/AstrexionTech/GreenStyle_Store-Backend",
        frontend: "https://github.com/AstrexionTech/GreenStyle_Store-Frontend",
        imagen: "/images/ejemplo_de_sitio_web_blog.jpg",
        urlHost: "/"
    }
]
---

<Layout title="Mis Proyectos - AstrexionTech's Portfolio">

    <h1>Portafolio de Proyectos</h1>
    
    <div class="grid-proyectos">
        {proyectos.map((proj) => (
            <ProjectCard 
                title={proj.titulo}
                description={proj.descripcion}
                stack={proj.stack}
                repoFront={proj.frontend}
                repoBack={proj.backend}
                demoUrl={proj.urlHost}
                image={proj.imagen}
            />
        ))}
    </div>
</Layout>

<style>
    h1 {
        text-align: center;
        padding: 2em;
    }
    .grid-proyectos { 
        display: flex;
        flex-direction: column; 
        gap: 1rem; 
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
    }
    .card { 
        border: 1px solid #ccc; 
        padding: 1rem; 
        border-radius: 8px; 
    }
    .card-header {
        padding: 4em;
        display: flex;         /* Activa el modo flexible */
        align-items: center;   /* Centra verticalmente el ícono con el texto */
        gap: 0.75rem;          /* Espacio entre el ícono y el título */
        margin-bottom: 1rem;
    }
    .badge { 
        background: orange; 
        color: black; 
        font-size: 0.8rem; 
        padding: 2px 5px; 
        border-radius: 4px; 
    }
</style>