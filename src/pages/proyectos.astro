---
import Layout from "../layouts/Layout.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { Icon } from 'astro-icon/components';

const proyectos = [
    {
        titulo: "E-commerce ASP.NET",
        descripcion: "Backend robusto con autenticación JWT.",
        stack: ["C#", ".NET 8", "SQL Server"],
        backend: "https://github.com/AstrexionTech/GreenStyle_Store-Backend",
        frontend: "https://github.com/AstrexionTech/GreenStyle_Store-Frontend",
        imagen: "/public/images/ejemplo_de_sitio_web_blog.jpg",
        urlHost: "/"
    }
]

---

<Layout title="Mis Proyectos - AstrexionTech's Portfolio">

    <div class="card-header">
        <Icon name="tabler:code" class="card-icon" />
        
        <h1>Portafolio de Proyectos</h1>
    </div>
    
    <div class="grid-proyectos">
        {proyectos.map((proj) => (
            <ProjectCard 
                title={proj.titulo}
                description={proj.descripcion}
                stack={proj.stack}
                repoFront={proj.frontend}
                repoBack={proj.backend}
                demoUrl={proj.urlHost}
                image={proj.imagen}
            />
        ))}
    </div>
</Layout>

<style>
    h1 {
        text-align: center;
    }
    .grid-proyectos { 
        display: flex;
        flex-direction: column; 
        gap: 1rem; 
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); 
    }
    .card { 
        border: 1px solid #ccc; 
        padding: 1rem; 
        border-radius: 8px; 
    }
    .card-header {
        display: flex;         /* Activa el modo flexible */
        align-items: center;   /* Centra verticalmente el ícono con el texto */
        gap: 0.75rem;          /* Espacio entre el ícono y el título */
        margin-bottom: 1rem;
    }
    .card-icon {
        font-size: 2rem;       /* Tamaño del ícono */
        color: #6366f1;        /* Color del ícono (ej. Índigo) */
        flex-shrink: 0;        /* Evita que el ícono se aplaste si el título es largo */
    }
    .badge { 
        background: orange; 
        color: black; 
        font-size: 0.8rem; 
        padding: 2px 5px; 
        border-radius: 4px; 
    }
</style>